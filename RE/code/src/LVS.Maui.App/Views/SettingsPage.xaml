<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LVS.Maui.App.ViewModels"
             x:Class="LVS.Maui.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="Settings" Style="{StaticResource Headline}" />

            <!-- Language Selection -->
            <Border Padding="12" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Language" Style="{StaticResource SectionHeader}" />
                    <Picker Title="Select Language"
                            ItemsSource="{Binding AvailableLocales}"
                            SelectedItem="{Binding SelectedLocale}">
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- App Info -->
            <Border Padding="12" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="About" Style="{StaticResource SectionHeader}" />
                    <Label Text="LVS Contact Center" />
                    <Label Text="Version 1.0.0" TextColor="Gray" />
                    <Label Text="Built with .NET MAUI 10" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
