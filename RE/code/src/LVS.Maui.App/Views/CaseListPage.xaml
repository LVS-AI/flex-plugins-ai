<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LVS.Maui.App.ViewModels"
             xmlns:models="clr-namespace:LVS.Core.Models;assembly=LVS.Core"
             x:Class="LVS.Maui.App.Views.CaseListPage"
             x:DataType="vm:CaseListViewModel"
             Title="Cases">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Filters -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="0,0,0,8">
            <Entry Placeholder="Counselor" Text="{Binding FilterCounselor}" WidthRequest="150" />
            <Picker Title="Status" SelectedItem="{Binding FilterStatus}" WidthRequest="120">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>open</x:String>
                        <x:String>closed</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Button Text="Search" Command="{Binding LoadCasesCommand}" Style="{StaticResource PrimaryButton}" />
        </HorizontalStackLayout>

        <!-- Case List -->
        <CollectionView Grid.Row="1" 
                         ItemsSource="{Binding Cases}"
                         EmptyView="No cases found. Apply filters and search.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Case">
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CaseListViewModel}}, Path=NavigateToCaseCommand}"
                                                  CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding Id, StringFormat='#{0}'}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding Status}" />
                            <Label Grid.Column="2" Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd}'}" TextColor="Gray" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pagination -->
        <HorizontalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="Center" Padding="0,8">
            <Button Text="Previous" Command="{Binding PreviousPageCommand}" />
            <Label Text="{Binding TotalCount, StringFormat='{0} total'}" VerticalOptions="Center" />
            <Button Text="Next" Command="{Binding NextPageCommand}" />
        </HorizontalStackLayout>

        <!-- Loading -->
        <ActivityIndicator Grid.RowSpan="3" 
                           IsRunning="{Binding IsLoading}" 
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>

</ContentPage>
