<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LVS.Maui.App.ViewModels"
             x:Class="LVS.Maui.App.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profiles">

    <Grid RowDefinitions="*" Padding="16">

        <!-- Profiles List or Detail based on state -->
        <Grid IsVisible="{Binding CurrentProfile, Converter={StaticResource NullToBoolConverter}}">
            <!-- Profiles List -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Client Profiles" Style="{StaticResource Headline}" />
                <Button Text="Refresh" Command="{Binding LoadProfilesListCommand}" HorizontalOptions="End" />

                <CollectionView ItemsSource="{Binding ProfilesList}"
                                EmptyView="No profiles found.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 4">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Id, StringFormat='Profile #{0}'}" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>

        <!-- Profile Detail View -->
        <Grid IsVisible="{Binding CurrentProfile, Converter={StaticResource NotNullToBoolConverter}}">
            <VerticalStackLayout Spacing="12">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Back" Clicked="OnBackClicked" />
                    <Label Text="{Binding CurrentProfile.Name}" Style="{StaticResource Headline}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Identifiers Banner -->
                <HorizontalStackLayout Spacing="4" IsVisible="{Binding CurrentProfile.Identifiers, Converter={StaticResource NotNullToBoolConverter}}">
                    <Label Text="Identifiers:" FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding CurrentProfile.Identifiers}" 
                                    ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,2" Margin="2" StrokeShape="RoundRectangle 4" BackgroundColor="LightGray">
                                    <Label Text="{Binding IdentifierValue}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </HorizontalStackLayout>

                <!-- Flags -->
                <HorizontalStackLayout Spacing="4">
                    <Label Text="Flags:" FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding CurrentProfile.ProfileFlags}"
                                    ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,2" Margin="2" StrokeShape="RoundRectangle 4" BackgroundColor="Orange">
                                    <Label Text="{Binding Name}" FontSize="12" TextColor="White" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </HorizontalStackLayout>

                <!-- Profile Tabs -->
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Contacts" Clicked="OnProfileContactsClicked" />
                    <Button Text="Cases" Clicked="OnProfileCasesClicked" />
                    <Button Text="Details" Clicked="OnProfileDetailsClicked" />
                </HorizontalStackLayout>

                <!-- Contacts Tab -->
                <CollectionView x:Name="ProfileContactsList"
                                ItemsSource="{Binding ProfileContacts}"
                                IsVisible="True"
                                EmptyView="No contacts linked.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,2" StrokeShape="RoundRectangle 4">
                                <Label Text="{Binding Id, StringFormat='Contact #{0}'}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Cases Tab -->
                <CollectionView x:Name="ProfileCasesList"
                                ItemsSource="{Binding ProfileCases}"
                                IsVisible="False"
                                EmptyView="No cases linked.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,2" StrokeShape="RoundRectangle 4">
                                <Label Text="{Binding Id, StringFormat='Case #{0}'}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Details Tab -->
                <VerticalStackLayout x:Name="ProfileDetailsList" IsVisible="False" Spacing="8">
                    <CollectionView ItemsSource="{Binding CurrentProfile.ProfileSections}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2" StrokeShape="RoundRectangle 4">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding SectionType}" FontAttributes="Bold" />
                                        <Label Text="{Binding Content}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsLoading}" 
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>

</ContentPage>
