<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:LVS.Maui.App.Converters">

    <!-- Value Converters -->
    <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
    <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
    <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    <converters:DateFormatConverter x:Key="DateFormatConverter" />

    <!-- ===== Text Styles ===== -->
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="SubHeader" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />
    </Style>

    <!-- ===== Button Styles ===== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="CallTypeButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource DividerColor}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TabInactiveColor}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ===== Entry / Editor Styles ===== -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextDisabledColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextDisabledColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ===== Card / Frame Style ===== -->
    <Style x:Key="CardFrame" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Stroke" Value="{StaticResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Status Badge Style ===== -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Divider ===== -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource DividerColor}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- ===== CollectionView Item Template ===== -->
    <Style x:Key="ListItemContainer" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Spacing" Value="4" />
    </Style>

    <!-- ===== Page / Content ===== -->
    <Style TargetType="ContentPage" ApplyDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundColor}" />
    </Style>

    <Style TargetType="Shell" ApplyDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="Shell.ForegroundColor" Value="White" />
        <Setter Property="Shell.TitleColor" Value="White" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondaryColor}" />
    </Style>

</ResourceDictionary>
